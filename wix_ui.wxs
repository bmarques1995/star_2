<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

    <!-- ============================================================
         UI específica por arquitetura
         ============================================================ -->

    <?foreach WIXUIARCH in X86;X64;A64 ?>

    <Fragment>

        <UI Id="CustomWixUI_InstallDir_$(WIXUIARCH)">

            <!-- BrowseDlg -->
            <Publish
                Dialog="BrowseDlg"
                Control="OK"
                Event="CheckTargetPath"
                Value="[WIXUI_INSTALLDIR]"
                Order="1" />

            <!--
                InstallDirDlg continua usando a validação
                padrão do WixUI.
            -->
            <Publish
                Dialog="InstallDirDlg"
                Control="Next"
                Event="CheckTargetPath"
                Value="[WIXUI_INSTALLDIR]"
                Order="1" />

            <!--
                Depois de escolher o diretório,
                continua para VerifyReadyDlg.
            -->
            <Publish
                Dialog="InstallDirDlg"
                Control="Next"
                Event="NewDialog"
                Value="VerifyReadyDlg"
                Order="4" />

        </UI>

        <UIRef Id="CustomWixUI_InstallDir" />

    </Fragment>

    <?endforeach ?>


    <!-- ============================================================
         UI PRINCIPAL
         ============================================================ -->

    <Fragment>

        <UI Id="file CustomWixUI_InstallDir">

            <!-- ====================================================
                 Fontes
                 ==================================================== -->

            <TextStyle
                Id="WixUI_Font_Normal"
                FaceName="Tahoma"
                Size="8" />

            <TextStyle
                Id="WixUI_Font_Bigger"
                FaceName="Tahoma"
                Size="12" />

            <TextStyle
                Id="WixUI_Font_Title"
                FaceName="Tahoma"
                Size="9"
                Bold="yes" />

            <Property
                Id="DefaultUIFont"
                Value="WixUI_Font_Normal" />


            <!-- ====================================================
                 Diálogos padrão
                 ==================================================== -->

            <DialogRef Id="BrowseDlg" />
            <DialogRef Id="DiskCostDlg" />
            <DialogRef Id="ErrorDlg" />
            <DialogRef Id="FatalError" />
            <DialogRef Id="FilesInUse" />
            <DialogRef Id="MsiRMFilesInUse" />
            <DialogRef Id="PrepareDlg" />
            <DialogRef Id="ProgressDlg" />
            <DialogRef Id="ResumeDlg" />
            <DialogRef Id="UserExit" />


            <!-- ====================================================
                 FINAL
                 ==================================================== -->

            <Publish
                Dialog="ExitDialog"
                Control="Finish"
                Event="EndDialog"
                Value="Return"
                Order="999" />


            <!-- ====================================================
                 WELCOME
                 ==================================================== -->

            <Publish
                Dialog="WelcomeDlg"
                Control="Next"
                Event="NewDialog"
                Value="LicenseAgreementDlg"
                Condition="NOT Installed" />

            <Publish
                Dialog="WelcomeDlg"
                Control="Next"
                Event="NewDialog"
                Value="VerifyReadyDlg"
                Condition="Installed AND PATCH" />


            <!-- ====================================================
                 LICENSE
                 ==================================================== -->

            <Publish
                Dialog="LicenseAgreementDlg"
                Control="Back"
                Event="NewDialog"
                Value="WelcomeDlg" />

            <!--
                ALTERAÇÃO PRINCIPAL:

                Antes:
                    LicenseAgreementDlg
                        ↓
                    InstallDirDlg

                Agora:
                    LicenseAgreementDlg
                        ↓
                    PathOptionsDlg
            -->

            <Publish
                Dialog="LicenseAgreementDlg"
                Control="Next"
                Event="NewDialog"
                Value="PathOptionsDlg"
                Condition="LicenseAccepted = &quot;1&quot;" />


            <!-- ====================================================
                 PATH OPTIONS
                 ==================================================== -->

            <Dialog
                Id="PathOptionsDlg"
                Width="370"
                Height="270"
                Title="Configurações da instalação">

                <!-- Título -->

                <Control
                    Id="Title"
                    Type="Text"
                    X="15"
                    Y="15"
                    Width="340"
                    Height="30"
                    Transparent="yes"
                    NoPrefix="yes"
                    Text="Configurações da instalação" />

                <!-- Descrição -->

                <Control
                    Id="Description"
                    Type="Text"
                    X="20"
                    Y="55"
                    Width="330"
                    Height="35"
                    Transparent="yes"
                    NoPrefix="yes"
                    Text="Escolha as opções adicionais para esta instalação." />

                <!-- =================================================
                     CHECKBOX
                     ================================================= -->

                <Control
                    Id="AddToPath"
                    Type="CheckBox"
                    X="20"
                    Y="105"
                    Width="330"
                    Height="18"
                    Property="ADD_TO_PATH"
                    CheckBoxValue="1"
                    Text="Adicionar ao PATH do Sistema" />

                <!-- Explicação -->

                <Control
                    Id="PathDescription"
                    Type="Text"
                    X="40"
                    Y="130"
                    Width="300"
                    Height="45"
                    Transparent="yes"
                    NoPrefix="yes"
                    Text="Adiciona a pasta bin ao PATH do Windows para permitir executar os programas diretamente pelo terminal." />


                <!-- =================================================
                     VOLTAR
                     ================================================= -->

                <Control
                    Id="Back"
                    Type="PushButton"
                    X="180"
                    Y="243"
                    Width="80"
                    Height="17"
                    Text="Voltar">

                    <Publish
                        Event="NewDialog"
                        Value="LicenseAgreementDlg" />

                </Control>


                <!-- =================================================
                     PRÓXIMO
                     ================================================= -->

                <Control
                    Id="Next"
                    Type="PushButton"
                    X="270"
                    Y="243"
                    Width="80"
                    Height="17"
                    Default="yes"
                    Text="Próximo">

                    <Publish
                        Event="NewDialog"
                        Value="InstallDirDlg" />

                </Control>


                <!-- =================================================
                     CANCELAR
                     ================================================= -->

                <Control
                    Id="Cancel"
                    Type="PushButton"
                    X="15"
                    Y="243"
                    Width="80"
                    Height="17"
                    Cancel="yes"
                    Text="Cancelar">

                    <Publish
                        Event="SpawnDialog"
                        Value="CancelDlg" />

                </Control>

            </Dialog>


            <!-- ====================================================
                 INSTALL DIRECTORY
                 ==================================================== -->

            <Publish
                Dialog="InstallDirDlg"
                Control="Back"
                Event="NewDialog"
                Value="LicenseAgreementDlg" />

            <Publish
                Dialog="InstallDirDlg"
                Control="Next"
                Event="SetTargetPath"
                Value="[WIXUI_INSTALLDIR]"
                Order="3" />

            <Publish
                Dialog="InstallDirDlg"
                Control="ChangeFolder"
                Property="_BrowseProperty"
                Value="[WIXUI_INSTALLDIR]"
                Order="1" />

            <Publish
                Dialog="InstallDirDlg"
                Control="ChangeFolder"
                Event="SpawnDialog"
                Value="BrowseDlg"
                Order="2" />

            <Publish
                Dialog="BrowseDlg"
                Control="OK"
                Event="SetTargetPath"
                Value="[_BrowseProperty]"
                Order="3" />

            <Publish
                Dialog="BrowseDlg"
                Control="OK"
                Event="EndDialog"
                Value="Return"
                Order="4" />


            <!-- ====================================================
                 VERIFY READY
                 ==================================================== -->

            <Publish
                Dialog="VerifyReadyDlg"
                Control="Back"
                Event="NewDialog"
                Value="InstallDirDlg"
                Order="1"
                Condition="NOT Installed" />

            <Publish
                Dialog="VerifyReadyDlg"
                Control="Back"
                Event="NewDialog"
                Value="MaintenanceTypeDlg"
                Order="2"
                Condition="Installed AND NOT PATCH" />

            <Publish
                Dialog="VerifyReadyDlg"
                Control="Back"
                Event="NewDialog"
                Value="WelcomeDlg"
                Order="2"
                Condition="Installed AND PATCH" />


            <!-- ====================================================
                 MAINTENANCE
                 ==================================================== -->

            <Publish
                Dialog="MaintenanceWelcomeDlg"
                Control="Next"
                Event="NewDialog"
                Value="MaintenanceTypeDlg" />

            <Publish
                Dialog="MaintenanceTypeDlg"
                Control="RepairButton"
                Event="NewDialog"
                Value="VerifyReadyDlg" />

            <Publish
                Dialog="MaintenanceTypeDlg"
                Control="RemoveButton"
                Event="NewDialog"
                Value="VerifyReadyDlg" />

            <Publish
                Dialog="MaintenanceTypeDlg"
                Control="Back"
                Event="NewDialog"
                Value="MaintenanceWelcomeDlg" />


            <!-- ====================================================
                 ARP
                 ==================================================== -->

            <Property
                Id="ARPNOMODIFY"
                Value="1" />


            <!-- ====================================================
                 COMMON UI
                 ==================================================== -->

            <UIRef Id="WixUI_Common" />

        </UI>

    </Fragment>

</Wix>
