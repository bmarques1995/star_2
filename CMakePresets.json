{
    "version": 3,
    "configurePresets": [
        {
            "name": "vcpkg-base",
            "hidden": true,
            "cacheVariables": {
                "USES_VCPKG": true,
                "VCPKG_PREFIX_PATH": "${sourceDir}/out/build/${presetName}/vcpkg_installed",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "vcpkg-linux-config",
            "hidden": true,
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
            }
        },
        {
            "name": "global-config",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "${sourceDir}/out/build/${presetName}"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja",
            "inherits": "global-config",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_AR": "llvm-ar",
                "CMAKE_RANLIB": "llvm-ranlib",
                "CMAKE_LINKER": "lld",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "BUILD_SHARED_LIBS": true
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "inherits": "linux-base",
            
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_LLVM_COVERAGE": true
            }
        },
        {
            "name": "linux-vcpkg-debug",
            "displayName": "Linux Debug with vcpkg",
            "inherits": ["linux-debug", "vcpkg-linux-config"]
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-vcpkg-release",
            "displayName": "Linux Release with vcpkg",
            "inherits": ["linux-release", "vcpkg-linux-config"]
        },
        {
            "name": "vcpkg-windows-config",
            "hidden": true,
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            },
            "environment": {
                "VCPKG_ROOT": "$env{VCPKG_OWN_ROOT}"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "inherits": "global-config",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "BUILD_SHARED_LIBS": true
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-debug",
            "displayName": "Windows Debug",
            "inherits": "windows-base",
            
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-vcpkg-debug",
            "displayName": "Windows Debug with vcpkg",
            "inherits": ["windows-debug", "vcpkg-windows-config"]
        },
        {
            "name": "windows-release",
            "displayName": "Windows Release",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-vcpkg-release",
            "displayName": "Windows Release with vcpkg",
            "inherits": ["windows-release", "vcpkg-windows-config"]
        }
    ]
}